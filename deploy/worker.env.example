# Salin ke /etc/soc-triage/worker.env, lalu: chmod 600 /etc/soc-triage/worker.env
# Berkas ini berisi API key. Jangan di-commit.

# Wazuh Indexer di server yang sama. Pakai akun yang hanya boleh membaca wazuh-alerts-*.
WAZUH_INDEXER_URL=https://127.0.0.1:9200
WAZUH_USER=triage_reader
WAZUH_PASSWORD=ganti-ini
# CA Indexer; path umum, cek di instalasi Anda. Kosongkan hanya bila CA sudah ada di trust store sistem.
WAZUH_CA=/etc/wazuh-indexer/certs/root-ca.pem

# Wajib: VirusTotal. Opsional: tiga sumber lain.
VT_API_KEY=
ABUSEIPDB_API_KEY=
URLSCAN_API_KEY=
HYBRID_API_KEY=

# Wajib minimal satu penyedia AI. Perlakukan semua tier gratis sebagai publik.
GEMINI_API_KEY=
# Key Gemini kedua (opsional, mis. akun lain): dicoba setelah key pertama gagal, dengan model yang sama
GEMINI_API_KEY_2=
# Nama model Gemini yang masih berlaku (kosong = bawaan di llm_providers.py)
GEMINI_MODEL=
# Urutan fallback tetap: Gemini -> NVIDIA -> Groq -> OpenRouter. Penyedia tanpa key dilewati.
# Model tiap penyedia (kosong = bawaan di llm_providers.py). Nama model gratis sering dipensiunkan:
# daftar yang berlaku ada lewat tombol "Cek model yang tersedia" di aplikasi.
NVIDIA_API_KEY=
NVIDIA_MODEL=
GROQ_API_KEY=
GROQ_MODEL=
OPENROUTER_API_KEY=
OPENROUTER_MODEL=

# Pengaturan worker (nilai di bawah adalah bawaan)
WORKER_MIN_LEVEL=7
WORKER_POLL_SECONDS=60
WORKER_MAX_PER_CYCLE=20
WORKER_LOOKBACK_MINUTES=15
# Jeda minimal antar request VirusTotal (detik). VT gratis sekitar 4 request/menit.
VT_MIN_INTERVAL_S=16
WORKER_TLS_VERIFY=true
WORKER_LLM_FALLBACK=true

# Folder tiket, state worker, dan cache CTI. Aplikasi Streamlit harus membaca folder yang sama (TICKETS_PATH).
DATA_DIR=/var/lib/soc-triage
